#!/bin/sh
# zapret2applet-helper — единственная привилегированная часть zapret2applet.
# Запускается от root через pkexec/polkit. Принимает ТОЛЬКО перечисленные ниже
# команды и строго валидирует аргументы; окружение вызывающего не используется.
set -eu

UNIT=zapret2.service
BASE=/opt/zapret2
BACKUP_ROOT=/var/backups/zapret2applet
RUNDIR=/run/zapret2applet
URLBASE=https://github.com/bol-van/zapret2/releases/download
PROTO='=https'
NOSVC=0
JOURNALCTL=journalctl
UNIT_DIR=/etc/systemd/system
TEST_MODE=0
SECURE_OWNER=0
TEST_ENFORCE_SECURITY=0

# Переопределения ТОЛЬКО для тестов. Игнорируются, если хелпер установлен в системный
# каталог; кроме того, pkexec сам очищает окружение вызывающего.
case "$0" in
    /usr/*|/opt/*|/etc/*|/bin/*|/sbin/*|/lib/*|/var/*) ;;
    *)
        if [ -n "${QZAPRET_TEST_BASE:-}" ]; then BASE=$QZAPRET_TEST_BASE; TEST_MODE=1; SECURE_OWNER=$(id -u); fi
        if [ -n "${QZAPRET_TEST_ENFORCE_SECURITY:-}" ]; then TEST_ENFORCE_SECURITY=1; fi
        if [ -n "${QZAPRET_TEST_BACKUP_DIR:-}" ]; then BACKUP_ROOT=$QZAPRET_TEST_BACKUP_DIR; fi
        if [ -n "${QZAPRET_TEST_RUNDIR:-}" ]; then RUNDIR=$QZAPRET_TEST_RUNDIR; fi
        if [ -n "${QZAPRET_TEST_URLBASE:-}" ]; then URLBASE=$QZAPRET_TEST_URLBASE; PROTO='=https,file'; fi
        if [ -n "${QZAPRET_TEST_NO_SERVICE:-}" ]; then NOSVC=1; fi
        if [ -n "${QZAPRET_TEST_JOURNALCTL:-}" ]; then JOURNALCTL=$QZAPRET_TEST_JOURNALCTL; fi
        if [ -n "${QZAPRET_TEST_UNIT_DIR:-}" ]; then UNIT_DIR=$QZAPRET_TEST_UNIT_DIR; fi
        ;;
esac
PIDFILE=$RUNDIR/blockcheck.pid

die() { echo "zapret2applet-helper: $*" >&2; exit 2; }

# Runtime state is private to root (or to the isolated test owner).
LOCKFILE=$RUNDIR/blockcheck.lock

prepare_runtime_dir() {
    parent=$(dirname "$RUNDIR")
    [ -d "$parent" ] && [ ! -L "$parent" ] || return 1
    secure_root_dir "$parent" || return 1
    if [ ! -e "$RUNDIR" ] && [ ! -L "$RUNDIR" ]; then
        mkdir -m 700 "$RUNDIR" 2>/dev/null || return 1
    fi
    secure_private_root_dir "$RUNDIR"
}

secure_runtime_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    info=$(stat -c '%u %a %h' -- "$1" 2>/dev/null) || return 1
    owner=$(printf '%s\n' "$info" | cut -d ' ' -f 1)
    perms=$(printf '%s\n' "$info" | cut -d ' ' -f 2)
    links=$(printf '%s\n' "$info" | cut -d ' ' -f 3)
    [ "$owner" = "$SECURE_OWNER" ] && [ "$links" = 1 ] || return 1
    [ $((0$perms & 077)) -eq 0 ]
}

proc_start_time() {
    [ -r "/proc/$1/stat" ] || return 1
    sed 's/^.*) //' "/proc/$1/stat" 2>/dev/null | awk '{ if (NF >= 20) print $20 }'
}

# PID plus kernel start time prevents stale PID reuse from identifying another process.
bc_pid() {
    prepare_runtime_dir || return 1
    secure_runtime_file "$PIDFILE" || return 1
    pid=
    start_time=
    extra=
    read -r pid start_time extra < "$PIDFILE" || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    case "$start_time" in ''|*[!0-9]*) return 1 ;; esac
    [ -z "$extra" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    current_start=$(proc_start_time "$pid") || return 1
    [ "$current_start" = "$start_time" ] || return 1
    tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q 'blockcheck2\.sh' || return 1
    echo "$pid"
}

need_arg() { [ "$1" -ge 2 ] || die "missing value for $2"; }


# Production paths must be controlled by root. The test harness uses private
# temporary directories and explicitly bypasses these installation checks.
secure_root_dir() {
    [ -d "$1" ] && [ ! -L "$1" ] || return 1
    info=$(stat -c '%u %a' -- "$1" 2>/dev/null) || return 1
    owner=$(printf '%s\n' "$info" | cut -d ' ' -f 1)
    perms=$(printf '%s\n' "$info" | cut -d ' ' -f 2)
    [ "$owner" = "$SECURE_OWNER" ] || return 1
    [ $((0$perms & 022)) -eq 0 ] || return 1
}

secure_private_root_dir() {
    secure_root_dir "$1" || return 1
    info=$(stat -c '%a' -- "$1" 2>/dev/null) || return 1
    [ $((0$info & 077)) -eq 0 ]
}

secure_root_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    info=$(stat -c '%u %a' -- "$1" 2>/dev/null) || return 1
    owner=$(printf '%s\n' "$info" | cut -d ' ' -f 1)
    perms=$(printf '%s\n' "$info" | cut -d ' ' -f 2)
    [ "$owner" = "$SECURE_OWNER" ] || return 1
    [ $((0$perms & 022)) -eq 0 ] || return 1
}

secure_list_dirs() {
    if [ "$TEST_MODE" = 1 ] && [ "$TEST_ENFORCE_SECURITY" != 1 ]; then return 0; fi
    if [ "$TEST_MODE" != 1 ]; then secure_root_dir /opt || return 1; fi
    secure_root_dir "$BASE" && secure_root_dir "$BASE/ipset"
}

secure_config_paths() {
    if [ "$TEST_MODE" = 1 ] && [ "$TEST_ENFORCE_SECURITY" != 1 ]; then return 0; fi
    if [ "$TEST_MODE" != 1 ]; then secure_root_dir /opt || return 1; fi
    secure_root_dir "$BASE" && secure_root_file "$BASE/config"
}

prepare_backup_root() {
    if [ "$TEST_MODE" != 1 ]; then
        secure_root_dir /var && secure_root_dir /var/backups || return 1
    fi
    if [ ! -e "$BACKUP_ROOT" ]; then
        mkdir "$BACKUP_ROOT" 2>/dev/null || return 1
        chmod 700 "$BACKUP_ROOT" || return 1
    fi
    [ ! -L "$BACKUP_ROOT" ] && secure_private_root_dir "$BACKUP_ROOT"
}

validate_domain_name() {
    python3 - "$1" <<'PY'
import re
import sys

domain = sys.argv[1]
if domain.endswith("."):
    domain = domain[:-1]
if not domain or len(domain) > 253:
    sys.exit(1)
for label in domain.split("."):
    if (not label or len(label) > 63 or
        not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", label)):
        sys.exit(1)
PY
}

validate_hostlist() {
    python3 - "$1" <<'PY'
import ipaddress
import re
import sys

try:
    data = open(sys.argv[1], "rb").read()
except OSError as exc:
    print("cannot read staged list: " + str(exc), file=sys.stderr)
    sys.exit(1)

if len(data) > 1048576:
    print("list exceeds the 1 MiB limit", file=sys.stderr)
    sys.exit(1)
try:
    source = data.decode("ascii")
except UnicodeDecodeError:
    print("hostlist must use ASCII or punycode", file=sys.stderr)
    sys.exit(1)

lines = source.split("\n")
if lines and lines[-1] == "":
    lines.pop()
if len(lines) > 50000:
    print("list exceeds 50000 lines", file=sys.stderr)
    sys.exit(1)

for number, raw in enumerate(lines, 1):
    if raw.endswith("\r"):
        raw = raw[:-1]
    if len(raw) > 4095:
        print("line %d exceeds 4095 characters" % number, file=sys.stderr)
        sys.exit(1)
    if any(ord(ch) < 32 and ch not in "\t\r" for ch in raw) or "\x7f" in raw:
        print("line %d contains a control character" % number, file=sys.stderr)
        sys.exit(1)

    line = raw.lstrip(" \t")
    if not line or line[0] in "#;/":
        continue

    # Match upstream hostlist.c: consume ^ and ! flags, then the first
    # whitespace-delimited token; any remaining text is ignored upstream.
    while line and line[0] in "^!":
        line = line[1:]
    token = re.split(r"[ \t\r\n]", line, maxsplit=1)[0]
    if not token:
        print("line %d contains flags without an entry" % number, file=sys.stderr)
        sys.exit(1)

    try:
        ipaddress.ip_network(token, strict=False)
        continue
    except ValueError:
        # Numeric/IP-looking strings must not be accepted as DNS labels.
        if "/" in token or ":" in token or re.fullmatch(r"[0-9.]+", token):
            print("line %d contains an invalid IP address or CIDR: %s" % (number, token), file=sys.stderr)
            sys.exit(1)

    domain = token[:-1] if token.endswith(".") else token
    if not domain or len(domain) > 253:
        print("line %d contains an invalid domain length" % number, file=sys.stderr)
        sys.exit(1)
    labels = domain.split(".")
    for label in labels:
        if (not label or len(label) > 63 or
            not re.fullmatch(r"[A-Za-z0-9_-]+", label) or
            label.startswith("-") or label.endswith("-")):
            print("line %d contains an invalid domain: %s" % (number, token), file=sys.stderr)
            sys.exit(1)
PY
}

case "${1:-}" in
lists-write)
    [ "$#" -eq 2 ] || die "usage: lists-write NAME"
    case "$2" in
        zapret-hosts-user.txt|zapret-hosts-user-exclude.txt|zapret-hosts-user-ipban.txt) ;;
        *) die "only source user hostlists are writable" ;;
    esac
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    ipset_dir="$BASE/ipset"
    [ -d "$ipset_dir" ] && [ ! -L "$ipset_dir" ] || die "ipset directory is missing or unsafe"
    secure_list_dirs || die "list directories must be root-owned and not writable by group or other users"
    list="$ipset_dir/$2"
    [ ! -L "$list" ] || die "list file must not be a symlink"
    if [ -e "$list" ]; then
        secure_root_file "$list" || die "list file must be regular, safely owned, and not group- or world-writable"
    fi

    tmp=$(mktemp "$ipset_dir/.list.zapret2applet.XXXXXX") || die "cannot create temporary list"
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    head -c 1048577 > "$tmp"
    size=$(wc -c < "$tmp" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine staged list size" ;; esac
    [ "$size" -le 1048576 ] || die "list exceeds the 1 MiB write limit"
    validate_hostlist "$tmp" || die "invalid hostlist; see the validation error above"

    chmod 644 "$tmp" || die "cannot set safe list permissions"
    chown --reference="$ipset_dir" "$tmp" || die "cannot set list ownership"

    prepare_backup_root || die "backup directory must be safely owned and private"
    list_backup_root="$BACKUP_ROOT/lists"
    if [ -e "$list_backup_root" ] && { [ ! -d "$list_backup_root" ] || [ -L "$list_backup_root" ]; }; then
        die "list backup directory is unsafe"
    fi
    [ -d "$list_backup_root" ] || { mkdir "$list_backup_root" && chmod 700 "$list_backup_root"; } || die "cannot create list backup directory"
    chmod 700 "$list_backup_root" || die "cannot secure list backup directory"
    secure_private_root_dir "$list_backup_root" || die "list backup directory must be safely owned and private"

    backup=""
    if [ -e "$list" ]; then
        backup=$(mktemp -d "$list_backup_root/$2-$(date +%Y%m%d-%H%M%S)-XXXXXX") || die "cannot create list backup"
        cp -p "$list" "$backup/list" || { rm -rf "$backup"; die "cannot back up current list"; }
        chmod 600 "$backup/list" || { rm -rf "$backup"; die "cannot secure list backup"; }
    fi
    sync -f "$tmp" || { [ -z "$backup" ] || rm -rf "$backup"; die "cannot sync staged list"; }
    mv -f -- "$tmp" "$list" || { [ -z "$backup" ] || rm -rf "$backup"; die "atomic list replacement failed"; }
    sync -f "$ipset_dir" || true
    trap - EXIT HUP INT TERM
    if [ -n "$backup" ]; then
        echo "OK: list updated; backup: $backup"
    else
        echo "OK: list created; no previous file existed"
    fi
    ;;
logs-read)
    [ "$#" -eq 2 ] || die "usage: logs-read {50|100|200|500}"
    case "$2" in 50|100|200|500) lines=$2 ;; *) die "log line count is not allowlisted" ;; esac
    command -v "$JOURNALCTL" >/dev/null 2>&1 || die "journalctl is not available"
    umask 077
    tmp=$(mktemp /tmp/zapret2applet-journal.XXXXXX) || die "cannot create temporary journal output"
    err=$(mktemp /tmp/zapret2applet-journal-error.XXXXXX) || {
        rm -f "$tmp"
        die "cannot create temporary journal error output"
    }
    trap 'rm -f "$tmp" "$err"' EXIT HUP INT TERM
    if ! "$JOURNALCTL" --unit="$UNIT" --lines="$lines" --no-pager --output=short-iso > "$tmp" 2> "$err"; then
        message=$(cat "$err")
        [ -n "$message" ] || message="journalctl exited unsuccessfully"
        die "cannot read service journal: $message"
    fi
    size=$(wc -c < "$tmp" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine journal output size" ;; esac
    if [ "$size" -gt 1048576 ]; then
        printf '[zapret2applet: output truncated to the most recent 1 MiB]\n'
        tail -c 1048500 "$tmp"
    else
        cat "$tmp"
    fi
    ;;
lists-read)
    [ "$#" -eq 2 ] || die "usage: lists-read NAME"
    case "$2" in
        zapret-hosts-user.txt|zapret-hosts-user-exclude.txt|zapret-hosts-user-ipban.txt|zapret-ip-user.txt|zapret-ip-user6.txt|zapret-ip-exclude.txt|zapret-ip-exclude6.txt|zapret-ip-user-ipban.txt|zapret-ip-user-ipban6.txt) ;;
        *) die "list name is not allowlisted" ;;
    esac
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    ipset_dir="$BASE/ipset"
    [ -d "$ipset_dir" ] && [ ! -L "$ipset_dir" ] || die "ipset directory is missing or unsafe"
    secure_list_dirs || die "list directories must be root-owned and not writable by group or other users"
    list="$ipset_dir/$2"
    [ -e "$list" ] || { echo "zapret2applet-helper: list file does not exist" >&2; exit 3; }
    secure_root_file "$list" || die "list file must be regular, safely owned, and not group- or world-writable"
    size=$(wc -c < "$list" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine list size" ;; esac
    [ "$size" -le 1048576 ] || die "list exceeds the 1 MiB read limit"
    cat "$list"
    ;;
config-read)
    [ "$#" -eq 1 ] || die "usage: config-read"
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    config="$BASE/config"
    [ -f "$config" ] && [ ! -L "$config" ] || die "config is missing or is not a regular file"
    secure_config_paths || die "config path and file must be safely owned and not group- or world-writable"
    size=$(wc -c < "$config" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine config size" ;; esac
    [ "$size" -le 1048576 ] || die "config exceeds the 1 MiB read limit"
    cat "$config"
    ;;
config-write)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die "usage: config-write [EXPECTED_SHA256]"
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    config="$BASE/config"
    [ -f "$config" ] && [ ! -L "$config" ] || die "config is missing or is not a regular file"
    secure_config_paths || die "config path and file must be safely owned and not group- or world-writable"
    expected_hash=""
    if [ "$#" -eq 2 ]; then
        expected_hash=$2
        case "$expected_hash" in ''|*[!0-9a-f]*) die "invalid expected config SHA-256" ;; esac
        [ "${#expected_hash}" -eq 64 ] || die "invalid expected config SHA-256"
        command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required for guarded config writes"
        current_hash=$(sha256sum "$config" | awk '{print $1}')
        [ "$current_hash" = "$expected_hash" ] || die "config changed since it was read; reload before saving"
    fi
    tmp=$(mktemp "$BASE/.config.zapret2applet.XXXXXX") || die "cannot create temporary config"
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    head -c 1048577 > "$tmp"
    size=$(wc -c < "$tmp" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine staged config size" ;; esac
    [ "$size" -le 1048576 ] || die "config exceeds the 1 MiB write limit"
    sh -n "$tmp" || die "shell syntax validation failed; config was not changed"
    chmod --reference="$config" "$tmp" || die "cannot preserve config permissions"
    chown --reference="$config" "$tmp" || die "cannot preserve config ownership"
    prepare_backup_root || die "backup directory is unsafe or unavailable"
    backup=$(mktemp -d "$BACKUP_ROOT/config-$(date +%Y%m%d-%H%M%S)-XXXXXX") || die "cannot create backup directory"
    cp -p "$config" "$backup/config" || { rm -rf "$backup"; die "cannot create config backup; config was not changed"; }
    chmod 600 "$backup/config" || { rm -rf "$backup"; die "cannot secure config backup; config was not changed"; }
    if [ -n "$expected_hash" ]; then
        backup_hash=$(sha256sum "$backup/config" | awk '{print $1}')
        [ "$backup_hash" = "$expected_hash" ] || {
            rm -rf "$backup"
            die "config changed while preparing the write; reload before saving"
        }
        current_hash=$(sha256sum "$config" | awk '{print $1}')
        [ "$current_hash" = "$expected_hash" ] || {
            rm -rf "$backup"
            die "config changed while preparing the write; reload before saving"
        }
    fi
    sync -f "$tmp" || { rm -rf "$backup"; die "cannot sync staged config; config was not changed"; }
    mv -f -- "$tmp" "$config" || { rm -rf "$backup"; die "atomic config replacement failed"; }
    sync -f "$BASE" || true
    trap - EXIT HUP INT TERM
    echo "OK: config updated; backup: $backup"
    ;;
config-rollback)
    [ "$#" -eq 1 ] || die "usage: config-rollback"
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    config="$BASE/config"
    [ -f "$config" ] && [ ! -L "$config" ] || die "config is missing or is not a regular file"
    secure_config_paths || die "config path and file must be safely owned and not group- or world-writable"
    prepare_backup_root || die "backup directory is unsafe or unavailable"
    restore=$(ls -1dt "$BACKUP_ROOT"/config-* 2>/dev/null | head -n 1)
    [ -n "$restore" ] && [ -d "$restore" ] && [ ! -L "$restore" ] || die "no config backups found"
    secure_private_root_dir "$restore" || die "latest config backup directory is unsafe"
    secure_root_file "$restore/config" || die "latest config backup file is unsafe"
    tmp=$(mktemp "$BASE/.config.zapret2applet.XXXXXX") || die "cannot create temporary config"
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    cp "$restore/config" "$tmp" || die "cannot stage backup"
    sh -n "$tmp" || die "backup failed shell syntax validation"
    chmod --reference="$config" "$tmp" || die "cannot preserve config permissions"
    chown --reference="$config" "$tmp" || die "cannot preserve config ownership"
    backup=$(mktemp -d "$BACKUP_ROOT/config-$(date +%Y%m%d-%H%M%S)-XXXXXX") || die "cannot preserve current config before rollback"
    cp -p "$config" "$backup/config" || { rm -rf "$backup"; die "cannot preserve current config; rollback canceled"; }
    chmod 600 "$backup/config" || { rm -rf "$backup"; die "cannot secure rollback backup"; }
    sync -f "$tmp" || { rm -rf "$backup"; die "cannot sync rollback config"; }
    mv -f -- "$tmp" "$config" || { rm -rf "$backup"; die "atomic rollback failed"; }
    sync -f "$BASE" || true
    trap - EXIT HUP INT TERM
    echo "OK: config restored from $restore; previous config backed up to $backup"
    ;;
unit)
    [ "$#" -eq 2 ] || die "usage: unit {start|stop|enable|disable}"
    case "$2" in
        start|stop|enable|disable) exec systemctl "$2" "$UNIT" ;;
        *) die "bad unit action" ;;
    esac
    ;;
blockcheck-submit)
    shift
    module_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || die "cannot locate helper modules"
    exec /usr/bin/python3 "$module_dir/blockcheck_submit.py" "$@"
    ;;
blockcheck-job-cancel)
    [ "$#" -eq 1 ] || die "usage: blockcheck-job-cancel"
    exec systemctl stop --no-block zapret2applet-blockcheck.service
    ;;
blockcheck-job-logs)
    [ "$#" -eq 3 ] || die "usage: blockcheck-job-logs {50|100|200|500} START_EPOCH"
    case "$2" in 50|100|200|500) lines=$2 ;; *) die "bad Blockcheck journal line count" ;; esac
    case "$3" in ''|*[!0-9]*) die "bad Blockcheck journal start time" ;; esac
    now=$(date +%s)
    [ "$3" -le "$now" ] && [ "$3" -ge "$((now - 2592000))" ] || die "Blockcheck journal start time is outside the allowed window"
    command -v "$JOURNALCTL" >/dev/null 2>&1 || die "journalctl is not available"
    umask 077
    tmp=$(mktemp /tmp/zapret2applet-blockcheck-journal.XXXXXX) || die "cannot create temporary journal output"
    err=$(mktemp /tmp/zapret2applet-blockcheck-journal-error.XXXXXX) || {
        rm -f "$tmp"
        die "cannot create temporary journal error output"
    }
    trap 'rm -f "$tmp" "$err"' EXIT HUP INT TERM
    if ! "$JOURNALCTL" --unit=zapret2applet-blockcheck.service --since="@$3" --lines="$lines" --no-pager --output=cat > "$tmp" 2> "$err"; then
        message=$(cat "$err")
        [ -n "$message" ] || message="journalctl exited unsuccessfully"
        die "cannot read Blockcheck journal: $message"
    fi
    size=$(wc -c < "$tmp" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine Blockcheck journal output size" ;; esac
    if [ "$size" -gt 1048576 ]; then
        printf '[zapret2applet: output truncated to the most recent 1 MiB]\n'
        tail -c 1048500 "$tmp"
    else
        cat "$tmp"
    fi
    ;;
blockcheck-job-status)
    [ "$#" -eq 2 ] || die "usage: blockcheck-job-status OPERATION_UUID"
    module_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || die "cannot locate helper modules"
    exec /usr/bin/python3 "$module_dir/blockcheck_status.py" "$2"
    ;;
blockcheck-worker)
    [ "$#" -eq 1 ] || die "usage: blockcheck-worker"
    module_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || die "cannot locate helper modules"
    exec /usr/bin/python3 "$module_dir/blockcheck_worker.py"
    ;;
blockcheck-recover)
    [ "$#" -eq 1 ] || die "usage: blockcheck-recover"
    module_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || die "cannot locate helper modules"
    exec /usr/bin/python3 "$module_dir/blockcheck_recovery.py"
    ;;
blockcheck)
    shift
    domains=rutracker.org ipvs=4 http=1 tls12=1 tls13=0 http3=0 repeats=1 scan=standard
    while [ $# -gt 0 ]; do
        need_arg $# "$1"
        case "$1" in
            --domains)   domains=$2 ;;
            --ipvs)      ipvs=$2 ;;
            --http)      http=$2 ;;
            --tls12)     tls12=$2 ;;
            --tls13)     tls13=$2 ;;
            --http3)     http3=$2 ;;
            --repeats)   repeats=$2 ;;
            --scanlevel) scan=$2 ;;
            *) die "unknown option $1" ;;
        esac
        shift 2
    done

    n=0
    set -f
    for d in $domains; do
        validate_domain_name "$d" || die "bad domain: $d"
        n=$((n + 1))
    done
    [ "$n" -ge 1 ] && [ "$n" -le 10 ] || die "1..10 domains required"
    case "$ipvs" in 4|6|46) ;; *) die "bad ipvs" ;; esac
    for f in "$http" "$tls12" "$tls13" "$http3"; do
        case "$f" in 0|1) ;; *) die "flag must be 0 or 1" ;; esac
    done
    case "$repeats" in ''|*[!0-9]*) die "bad repeats" ;; esac
    [ "$repeats" -ge 1 ] && [ "$repeats" -le 10 ] || die "repeats must be 1..10"
    case "$scan" in veryquick|quick|standard|force) ;; *) die "bad scanlevel" ;; esac

    [ -f "$BASE/blockcheck2.sh" ] && [ ! -L "$BASE/blockcheck2.sh" ] || die "zapret2 not found or unsafe in $BASE"
    prepare_runtime_dir || die "runtime directory must be root-owned and private (0700)"
    [ ! -e "$LOCKFILE" ] && [ ! -L "$LOCKFILE" ] || secure_runtime_file "$LOCKFILE" || die "runtime lock file is unsafe"
    command -v flock >/dev/null 2>&1 || die "flock is required for safe Blockcheck lifecycle management"
    umask 077
    : >> "$LOCKFILE"
    chmod 600 "$LOCKFILE"
    secure_runtime_file "$LOCKFILE" || die "runtime lock file must be safely owned and private"
    exec 9>"$LOCKFILE"
    flock -n 9 || die "blockcheck already running"
    bc_pid >/dev/null && die "blockcheck already running"
    if [ -e "$PIDFILE" ] || [ -L "$PIDFILE" ]; then
        secure_runtime_file "$PIDFILE" || die "runtime PID file is unsafe"
        rm -f "$PIDFILE"
    fi
    IFS= read -r self_stat < /proc/self/stat || die "cannot identify helper process"
    self_pid=${self_stat%% *}
    start_time=$(proc_start_time "$self_pid") || die "cannot determine helper process start time"
    printf '%s %s\n' "$self_pid" "$start_time" > "$PIDFILE"
    chmod 600 "$PIDFILE"
    secure_runtime_file "$PIDFILE" || die "cannot secure runtime PID file"
    # exec preserves the PID and lock descriptor for the lifetime of blockcheck2.sh.
    exec env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C.UTF-8 \
        BATCH=1 DOMAINS="$domains" IPVS="$ipvs" \
        ENABLE_HTTP="$http" ENABLE_HTTPS_TLS12="$tls12" \
        ENABLE_HTTPS_TLS13="$tls13" ENABLE_HTTP3="$http3" \
        REPEATS="$repeats" SCANLEVEL="$scan" \
        sh "$BASE/blockcheck2.sh"
    ;;
blockcheck-cancel)
    [ "$#" -eq 1 ] || die "usage: blockcheck-cancel"
    prepare_runtime_dir || die "runtime directory is unsafe"
    [ -e "$LOCKFILE" ] && secure_runtime_file "$LOCKFILE" || { echo "zapret2applet-helper: blockcheck is not running" >&2; exit 0; }
    exec 9>"$LOCKFILE"
    flock -n 9 && { echo "zapret2applet-helper: blockcheck is not running" >&2; exit 0; }
    pid=$(bc_pid) || { echo "zapret2applet-helper: blockcheck is not running" >&2; exit 0; }
    # SIGINT: обработчик blockcheck2.sh печатает "terminating..." и чистит правила/процессы.
    # Если процесс стартовал с игнорируемым SIGINT, через ~3 с шлём SIGTERM (обработчик
    # sigsilent делает ту же очистку). SIGKILL не используем: он оставил бы правила nft.
    kill -INT "$pid" 2>/dev/null || exit 0
    for _ in 1 2 3; do
        sleep 1
        bc_pid >/dev/null || exit 0
    done
    kill -TERM "$pid" 2>/dev/null || true
    ;;
install)
    [ "$#" -eq 2 ] || die "usage: install vX.Y.Z"
    tag=$2
    case "$tag" in v[0-9]*) ;; *) die "bad tag" ;; esac
    case "$tag" in *[!0-9.v]*|*..*|*.|v*v*) die "bad tag" ;; esac
    [ ${#tag} -le 24 ] || die "bad tag"
    command -v curl >/dev/null 2>&1 || die "curl is required"
    command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required"
    command -v tar >/dev/null 2>&1 || die "tar is required"
    command -v systemctl >/dev/null 2>&1 || [ "$NOSVC" = 1 ] || die "systemctl is required"
    parent=$(dirname "$BASE")
    [ -d "$parent" ] && [ ! -L "$parent" ] || die "installation parent directory is missing or unsafe"
    if [ "$TEST_MODE" != 1 ]; then
        secure_root_dir "$parent" || die "installation parent must be root-owned and not writable by group or other users"
    fi
    [ ! -e "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 already exists at $BASE; clean installation will not overwrite it"
    [ -d "$UNIT_DIR" ] && [ ! -L "$UNIT_DIR" ] || die "systemd unit directory is missing or unsafe"
    if [ "$TEST_MODE" != 1 ]; then
        secure_root_dir "$UNIT_DIR" || die "systemd unit directory must be root-owned and not writable by group or other users"
        for existing_unit in /etc/systemd/system/zapret2.service /usr/lib/systemd/system/zapret2.service /lib/systemd/system/zapret2.service; do
            [ ! -e "$existing_unit" ] && [ ! -L "$existing_unit" ] || die "zapret2 systemd unit already exists: $existing_unit"
        done
    fi
    [ ! -e "$UNIT_DIR/zapret2.service" ] && [ ! -L "$UNIT_DIR/zapret2.service" ] || die "zapret2 systemd unit already exists in $UNIT_DIR"

    umask 077
    mkdir -p "$RUNDIR"
    mkdir "$RUNDIR/install.lock" 2>/dev/null || die "another installation is in progress"
    tmp=$(mktemp -d "$parent/.zapret2applet-install.XXXXXX") || { rmdir "$RUNDIR/install.lock"; die "cannot create temporary installation directory"; }
    unit_tmp=""
    cleanup_install() {
        [ -z "$unit_tmp" ] || rm -f "$unit_tmp"
        rm -rf "$tmp"
        rmdir "$RUNDIR/install.lock" 2>/dev/null || true
    }
    trap cleanup_install EXIT HUP INT TERM

    name="zapret2-$tag"
    fetch() {
        curl -fsSL --proto "$PROTO" --proto-redir '=https' --tlsv1.2 \
            --connect-timeout 20 --max-time 600 --max-filesize 300000000 -o "$2" "$1"
    }
    echo "Downloading clean-install archive $name.tar.gz ..."
    fetch "$URLBASE/$tag/$name.tar.gz" "$tmp/z.tgz" || die "download failed"
    fetch "$URLBASE/$tag/sha256sum.txt" "$tmp/sums.txt" || die "download of sha256sum.txt failed"

    echo "Validating archive structure ..."
    tar -tzf "$tmp/z.tgz" > "$tmp/list" 2>/dev/null || die "corrupt archive"
    [ -s "$tmp/list" ] || die "empty archive"
    entries=$(wc -l < "$tmp/list" | tr -d '[:space:]')
    [ "$entries" -le 50000 ] || die "archive contains too many entries"
    tar -tvzf "$tmp/z.tgz" | awk '$1 ~ /^-/ { total += $3; files++ } END { if (files > 50000 || total > 536870912) exit 1 }' \
        || die "archive exceeds the extraction limits"
    if grep -qE '(^/|(^|/)\.\.(/|$))' "$tmp/list"; then die "unsafe paths in archive"; fi
    if grep -qv "^$name/" "$tmp/list"; then die "unexpected content outside $name/"; fi
    if tar -tvzf "$tmp/z.tgz" | cut -c1 | grep -qv '[-d]'; then die "links or special files in archive"; fi

    [ -s "$tmp/sums.txt" ] || die "empty sha256sum.txt"
    if grep -qvE "^[0-9a-f]{64}  $name/binaries/[A-Za-z0-9._/+-]+\$" "$tmp/sums.txt"; then
        die "unexpected sha256sum.txt format"
    fi

    mkdir "$tmp/extract"
    umask 022
    tar -xzf "$tmp/z.tgz" -C "$tmp/extract" --no-same-owner || die "extract failed"
    stage="$tmp/extract/$name"
    [ -d "$stage" ] && [ ! -L "$stage" ] || die "unexpected archive layout"
    chmod -R ug-s "$stage"
    chmod -R go-w "$stage"
    ( cd "$tmp/extract" && sha256sum -c --quiet "$tmp/sums.txt" ) || die "binary checksum mismatch"
    for required in config.default blockcheck2.sh install_bin.sh docs/changes.txt common/base.sh init.d/sysv/zapret2 init.d/systemd/zapret2.service; do
        [ -f "$stage/$required" ] && [ ! -L "$stage/$required" ] || die "archive is missing required file: $required"
    done
    newver=$(grep -E '^[0-9]+(\.[0-9]+)+[[:space:]]*$' "$stage/docs/changes.txt" | tail -n 1 | tr -d '[:space:]')
    [ -x "$stage/init.d/sysv/zapret2" ] || die "upstream sysv init script is not executable"
    [ "$newver" = "${tag#v}" ] || die "version mismatch: archive says '$newver', expected '${tag#v}'"

    config_assignments=$(grep -Ec '^[[:space:]]*NFQWS2_ENABLE[[:space:]]*=' "$stage/config.default" || true)
    [ "$config_assignments" = 1 ] && grep -q '^NFQWS2_ENABLE=0$' "$stage/config.default" \
        || die "upstream default config does not explicitly disable NFQWS2"
    sh -n "$stage/config.default" || die "upstream default config has invalid shell syntax"
    cp "$stage/config.default" "$stage/config" || die "cannot create initial config"
    chmod 600 "$stage/config" || die "cannot secure initial config"

    echo "Selecting compatible Linux binaries ..."
    env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C.UTF-8 \
        sh "$stage/install_bin.sh" > "$tmp/install_bin.log" 2>&1 \
        || { cat "$tmp/install_bin.log" >&2; die "install_bin.sh failed: no compatible binaries"; }
    [ -x "$stage/nfq2/nfqws2" ] && [ -x "$stage/ip2net/ip2net" ] && [ -x "$stage/mdig/mdig" ] \
        || die "binary links were not created"
    "$stage/nfq2/nfqws2" --version >/dev/null 2>&1 || die "nfqws2 does not run on this system"
    printf '0.0.0.0\n' | "$stage/ip2net/ip2net" >/dev/null 2>&1 || die "ip2net does not run on this system"

    unit="$stage/init.d/systemd/zapret2.service"
    grep -q '^ExecStart=/opt/zapret2/init.d/sysv/zapret2 start$' "$unit" \
        && grep -q '^ExecStop=/opt/zapret2/init.d/sysv/zapret2 stop$' "$unit" \
        || die "upstream systemd unit does not match the expected installation paths"
    unit_tmp=$(mktemp "$UNIT_DIR/.zapret2.service.XXXXXX") || die "cannot stage systemd unit"
    cp "$unit" "$unit_tmp" || die "cannot stage systemd unit"
    chmod 644 "$unit_tmp" || die "cannot set systemd unit permissions"

    echo "Installing files into $BASE ..."
    mv "$stage" "$BASE" || die "cannot move validated installation into place"
    if ! mv "$unit_tmp" "$UNIT_DIR/zapret2.service"; then
        rm -rf "$BASE"
        die "cannot install systemd unit; installation rolled back"
    fi
    if [ "$NOSVC" != 1 ]; then
        systemctl daemon-reload || {
            rm -f "$UNIT_DIR/zapret2.service"
            rm -rf "$BASE"
            systemctl daemon-reload >/dev/null 2>&1 || true
            die "systemd daemon-reload failed; installation rolled back"
        }
    fi
    echo "OK: zapret2 installed to $BASE"
    echo "The service was not started or enabled. NFQWS2_ENABLE=0; configure zapret2 before starting it."
    ;;
update)
    # update vX.Y.Z — скачать релиз zapret2 с github.com/bol-van/zapret2 и обновить $BASE.
    # Файлы пользователя (config, ipset/zapret-hosts-user*.txt, init.d/*/custom.d) в архиве
    # отсутствуют, поэтому наложение файлов поверх их не затрагивает.
    [ "$#" -eq 2 ] || die "usage: update vX.Y.Z"
    tag=$2
    case "$tag" in v[0-9]*) ;; *) die "bad tag" ;; esac
    case "$tag" in *[!0-9.v]*|*..*|*.|v*v*) die "bad tag" ;; esac
    [ ${#tag} -le 24 ] || die "bad tag"
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    [ -f "$BASE/install_bin.sh" ] || die "$BASE does not look like zapret2"
    command -v curl >/dev/null 2>&1 || die "curl is required"
    command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required"
    bc_pid >/dev/null && die "blockcheck is running, cancel it first"

    umask 022
    mkdir -p "$RUNDIR"
    mkdir "$RUNDIR/update.lock" 2>/dev/null || die "another update is in progress"
    name="zapret2-$tag"
    tmp=$(mktemp -d /var/tmp/zapret2applet-update.XXXXXX) || { rmdir "$RUNDIR/update.lock"; die "mktemp failed"; }
    trap 'rm -rf "$tmp"; rmdir "$RUNDIR/update.lock" 2>/dev/null || true' EXIT

    fetch() {
        curl -fsSL --proto "$PROTO" --proto-redir '=https' --tlsv1.2 \
            --connect-timeout 20 --max-time 600 --max-filesize 300000000 -o "$2" "$1"
    }
    echo "Downloading $name.tar.gz ..."
    fetch "$URLBASE/$tag/$name.tar.gz" "$tmp/z.tgz" || die "download failed"
    fetch "$URLBASE/$tag/sha256sum.txt" "$tmp/sums.txt" || die "download of sha256sum.txt failed"

    echo "Checking archive ..."
    tar -tzf "$tmp/z.tgz" > "$tmp/list" 2>/dev/null || die "corrupt archive"
    [ -s "$tmp/list" ] || die "empty archive"
    entries=$(wc -l < "$tmp/list" | tr -d '[:space:]')
    [ "$entries" -le 50000 ] || die "archive contains too many entries"
    tar -tvzf "$tmp/z.tgz" | awk '$1 ~ /^-/ { total += $3; files++ } END { if (files > 50000 || total > 536870912) exit 1 }' \
        || die "archive exceeds the extraction limits"
    if grep -qE '(^/|(^|/)\.\.(/|$))' "$tmp/list"; then die "unsafe paths in archive"; fi
    if grep -qv "^$name/" "$tmp/list"; then die "unexpected content outside $name/"; fi
    # Только обычные файлы и каталоги: ни ссылок, ни устройств.
    if tar -tvzf "$tmp/z.tgz" | cut -c1 | grep -qv '[-d]'; then die "links or special files in archive"; fi

    mkdir "$tmp/x"
    tar -xzf "$tmp/z.tgz" -C "$tmp/x" --no-same-owner || die "extract failed"
    stage="$tmp/x/$name"
    [ -d "$stage" ] && [ ! -L "$stage" ] || die "unexpected archive layout"
    chmod -R ug-s "$stage"
    chmod -R go-w "$stage"

    echo "Verifying checksums of binaries (sha256sum.txt from the release) ..."
    [ -s "$tmp/sums.txt" ] || die "empty sha256sum.txt"
    if grep -qvE "^[0-9a-f]{64}  $name/binaries/[A-Za-z0-9._/+-]+\$" "$tmp/sums.txt"; then
        die "unexpected sha256sum.txt format"
    fi
    ( cd "$tmp/x" && sha256sum -c --quiet "$tmp/sums.txt" ) || die "checksum mismatch, nothing was changed"

    for f in blockcheck2.sh install_bin.sh docs/changes.txt; do
        [ -f "$stage/$f" ] || die "archive has no $f"
    done
    newver=$(grep -E '^[0-9]+(\.[0-9]+)+[[:space:]]*$' "$stage/docs/changes.txt" | tail -n 1 | tr -d '[:space:]')
    [ "$newver" = "${tag#v}" ] || die "version mismatch: archive says '$newver', expected '${tag#v}'"

    svc() { [ "$NOSVC" = 1 ] || systemctl "$1" "$UNIT"; }
    was_active=0
    if [ "$NOSVC" != 1 ] && systemctl is-active --quiet "$UNIT" 2>/dev/null; then was_active=1; fi
    [ "$was_active" = 1 ] && { echo "Stopping $UNIT ..."; svc stop || die "cannot stop $UNIT"; }

    bak="$BASE.bak"
    rm -rf "$bak"
    echo "Backing up the current installation to $bak ..."
    if ! cp -a "$BASE" "$bak"; then
        rm -rf "$bak"
        [ "$was_active" = 1 ] && svc start || true
        die "backup failed, nothing was changed"
    fi

    rollback() {
        echo "Rolling back to the previous version ..." >&2
        rm -rf "$BASE" && mv "$bak" "$BASE" || echo "zapret2applet-helper: ROLLBACK FAILED, previous version is in $bak" >&2
        [ "$was_active" = 1 ] && svc start || true
    }

    echo "Installing $tag into $BASE ..."
    cp -a "$stage/." "$BASE/" || { rollback; die "copy failed"; }
    env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C.UTF-8 \
        sh "$BASE/install_bin.sh" </dev/null >"$tmp/install_bin.log" 2>&1 \
        || { cat "$tmp/install_bin.log" >&2; rollback; die "install_bin.sh failed"; }
    "$BASE/nfq2/nfqws2" --version >/dev/null 2>&1 || { rollback; die "nfqws2 does not run on this system"; }

    [ "$was_active" = 1 ] && { echo "Starting $UNIT ..."; svc start || echo "zapret2applet-helper: WARNING: cannot start $UNIT" >&2; }
    echo "OK: zapret2 updated to $tag (previous version kept in $bak)"
    ;;
*)
    die "usage: zapret2applet-helper logs-read {50|100|200|500} | lists-read NAME | lists-write NAME | config-read | config-write [EXPECTED_SHA256] | config-rollback | unit {start|stop|enable|disable} | blockcheck-submit [opts] | blockcheck-worker | blockcheck-recover | blockcheck-job-status OPERATION_UUID | blockcheck-job-logs {50|100|200|500} START_EPOCH | blockcheck-job-cancel | blockcheck [opts] | blockcheck-cancel | install vX.Y.Z | update vX.Y.Z"
    ;;
esac
