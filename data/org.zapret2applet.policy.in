<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>zapret2applet</vendor>
  <vendor_url>https://github.com/avsprv/zapret2applet</vendor_url>

  <action id="org.zapret2applet.helper">
    <description>Manage zapret2 and run DPI strategy scan</description>
    <description xml:lang="ru">Управление zapret2 и подбор стратегий обхода DPI</description>
    <message>Authentication is required to manage zapret2</message>
    <message xml:lang="ru">Для управления zapret2 требуется аутентификация</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
  </action>

  <action id="org.zapret2applet.blockcheck-recovery-probe">
    <description>Read Blockcheck recovery state</description>
    <description xml:lang="ru">Проверка состояния восстановления Blockcheck</description>
    <message>Read-only Blockcheck recovery status</message>
    <message xml:lang="ru">Проверка состояния Blockcheck без изменения системы</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">blockcheck-recovery-probe</annotate>
  </action>

  <action id="org.zapret2applet.config-read">
    <description>Read the zapret2 configuration</description>
    <description xml:lang="ru">Чтение конфигурации zapret2</description>
    <message>Authentication is required to read the zapret2 configuration</message>
    <message xml:lang="ru">Для чтения конфигурации zapret2 требуется аутентификация</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">config-read</annotate>
  </action>


  <action id="org.zapret2applet.config-write">
    <description>Write the zapret2 configuration</description>
    <description xml:lang="ru">Изменение конфигурации zapret2</description>
    <message>Authentication is required to change the zapret2 configuration</message>
    <message xml:lang="ru">Для изменения конфигурации zapret2 требуется аутентификация</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">config-write</annotate>
  </action>
  <action id="org.zapret2applet.config-rollback">
    <description>Restore the previous zapret2 configuration</description>
    <description xml:lang="ru">Откат конфигурации zapret2</description>
    <message>Authentication is required to restore the previous zapret2 configuration</message>
    <message xml:lang="ru">Для отката конфигурации zapret2 требуется аутентификация</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">config-rollback</annotate>
  </action>


  <action id="org.zapret2applet.logs-read">
    <description>Read the zapret2 service journal</description>
    <description xml:lang="ru">Чтение журнала службы zapret2</description>
    <message>Authentication is required to read the zapret2 service journal</message>
    <message xml:lang="ru">Для чтения журнала службы zapret2 требуется аутентификация</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">logs-read</annotate>
  </action>

  <action id="org.zapret2applet.lists-read">
    <description>Read standard user lists</description>
    <description xml:lang="ru">Чтение стандартных пользовательских списков</description>
    <message>Authentication is required to read zapret2 user lists</message>
    <message xml:lang="ru">Для чтения пользовательских списков zapret2 требуется аутентификация</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">lists-read</annotate>
  </action>
  <action id="org.zapret2applet.lists-write">
    <description>Modify standard user hostlists</description>
    <description xml:lang="ru">Изменение стандартных пользовательских хостлистов</description>
    <message>Authentication is required to modify zapret2 user hostlists</message>
    <message xml:lang="ru">Для изменения пользовательских хостлистов zapret2 требуется аутентификация</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">lists-write</annotate>
  </action>


  <!-- Чистая установка загружает и устанавливает код, исполняемый с правами root. -->
  <action id="org.zapret2applet.install">
    <description>Install zapret2 from GitHub</description>
    <description xml:lang="ru">Чистая установка zapret2 с GitHub</description>
    <message>Authentication is required to download and install zapret2</message>
    <message xml:lang="ru">Для загрузки и установки zapret2 требуется аутентификация</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">install</annotate>
  </action>

  <!-- Обновление zapret2 скачивает из сети и заменяет код, исполняемый от root, поэтому
       запрашивает пароль каждый раз (без auth_admin_keep). Действие выбирается по argv[1]. -->
  <action id="org.zapret2applet.update">
    <description>Update zapret2 from GitHub</description>
    <description xml:lang="ru">Обновление zapret2 с GitHub</description>
    <message>Authentication is required to download and install a new zapret2 version</message>
    <message xml:lang="ru">Для загрузки и установки новой версии zapret2 требуется аутентификация</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">update</annotate>
  </action>
</policyconfig>
