#!/bin/sh
set -e

legacy_unit_installed() {
    [ -e "/usr/lib/systemd/system/$1" ] || [ -e "/lib/systemd/system/$1" ]
}

case "$1" in
    install|upgrade)
        for unit in \
            zapret2applet-blockcheck.service \
            zapret2applet-blockcheck-recovery.service
        do
            # Run the old ExecStopPost recovery helper before unpack replaces it.
            if legacy_unit_installed "$unit"; then
                if command -v deb-systemd-invoke >/dev/null 2>&1; then
                    deb-systemd-invoke stop "$unit"
                elif command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
                    systemctl stop "$unit"
                fi

                # Disable while the legacy unit file is still available to systemd.
                if command -v deb-systemd-helper >/dev/null 2>&1; then
                    deb-systemd-helper disable "$unit"
                fi
            fi
        done
        ;;
esac
